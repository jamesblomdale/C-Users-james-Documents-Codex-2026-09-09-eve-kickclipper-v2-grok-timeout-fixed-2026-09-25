# Kick channel to watch (just the username, e.g. "sneako")
KICK_CHANNEL=

# LLM provider for moment detection + post generation: "grok" or "openai"
# ROLE 2 - MOMENT ANALYSIS ONLY (Grok/OpenAI). Never used for transcription.
LLM_PROVIDER=openai
LLM_API_KEY=

# 0-100, how clip-worthy a moment needs to score to get clipped
CLIP_SCORE_THRESHOLD=60

# Whisper model size: tiny, base, small, medium, large-v3
# small is a good balance of speed/accuracy for real-time on modest hardware
WHISPER_MODEL_SIZE=small

# Seconds of rolling video to buffer at a time
CHUNK_SECONDS=30

# Seconds of transcript context to send to the LLM for scoring
DETECTION_WINDOW_SECONDS=45

# Directory chunks/clips get written to
OUTPUT_DIR=output

# "9:16" (TikTok/Shorts), "16:9" (YouTube/original), "4:3", or "1:1"
ASPECT_RATIO=9:16

# true = smoothed face tracking crop, false = plain center crop
TRACKING_ENABLED=false

# Whether to burn captions into clips at all
CAPTIONS_ENABLED=true

# Comma-separated high-value names that boost a moment's Name Strength score
# and get emphasized in generated titles
PRIORITY_NAMES=N3on,Sneako,Clavicular,Adrien Broner,Deen the Great

# Whether to skip clipping moments flagged for minors, explicit content,
# or unverified serious claims
SAFETY_FLAGS_ENABLED=true

# Optional: Apify API token, used to download Kick VODs when yt-dlp's
# built-in Kick support is broken (which it currently is). Get one at
# https://console.apify.com/account#/integrations -- this is a paid
# third-party service, priced by file size (a few cents per VOD).
APIFY_API_TOKEN=

# ---------- SaaS layer ----------

# Signs session cookies. Set this to a real random value before any
# real users exist -- changing it later logs everyone out at once.
SECRET_KEY=

# The very first account. Set both and restart once to create it.
OWNER_EMAIL=
OWNER_PASSWORD=

# 1 credit = 1 processed source minute.
CREDIT_RATE_VOD=1.0
CREDIT_RATE_LIVE=1.5

# Stripe -- leave blank to run with checkout disabled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Pipeline upgrade: start conservatively on CPU; benchmark before increasing.
WHISPER_BATCH_SIZE=1
WHISPER_BEAM_SIZE='1'
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=
VISION_MODEL=
GROK_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# OpenAI is an optional moment-analysis provider. Add the key in Admin or here.
OPENAI_API_KEY=
OPENAI_TITLE_MODEL=gpt-5.4-mini
# Match the OpenAI project limit shown on its Limits page. Requests are paced
# below this value so concurrent transcript batches are retried, never dropped.
OPENAI_TPM_LIMIT=200000

# Bounded second-pass review: 0 disables, maximum 20 candidates.
CONTEXT_REVIEW_LIMIT=0
VIDEO_REVIEW_PROVIDER=frames
# Optional Gemini candidate video/audio review (never used unless selected).
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
WHISPER_VOD_BEAM_SIZE='1'
WHISPER_LIVE_BEAM_SIZE='1'

# Transcription engine. This Parakeet-first build uses Together AI by default.
# Add TOGETHER_API_KEY before starting a long job. Local Whisper fallback is
# deliberately disabled so a cloud failure cannot silently turn into hours of CPU ASR.
# ROLE 1 - TRANSCRIPTION ONLY. Parakeet uses TOGETHER_API_KEY; Grok is never called here.
TRANSCRIPTION_PROVIDER=parakeet
ASR_PROVIDER=parakeet
TRANSCRIPTION_FALLBACK=none
WHISPER_FALLBACK=false

# Together AI Parakeet (fast batch VOD transcription)
# Get a Together API key, then set # ROLE 1 - TRANSCRIPTION ONLY. Parakeet uses TOGETHER_API_KEY; Grok is never called here.
TRANSCRIPTION_PROVIDER=parakeet
TOGETHER_API_KEY=
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
PARAKEET_LANGUAGE=en
PARAKEET_CONCURRENCY=2
PARAKEET_CHUNK_SECONDS=240
PARAKEET_CHUNK_OVERLAP_SECONDS=15
PARAKEET_VERIFY_CREDENTIALS=true
PARAKEET_LOCAL_FALLBACK=false
PARAKEET_TIMEOUT_SECONDS=180
PARAKEET_MAX_RETRIES=4
# Together supports diarization on the transcription API. Leave false until
# you have verified it on your selected model/account; speaker separation can
# also remain a downstream stage.
PARAKEET_DIARIZE=false
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
MAI_MODEL=MAI-Transcribe-2
MAI_API_VERSION=2025-10-15
MAI_LANGUAGE=en
MAI_TRANSCRIBE_STYLE=verbatim
MAI_CHUNK_MINUTES=15
MAI_CHUNK_OVERLAP_SECONDS=8
MAI_CONCURRENCY=4
MAI_TIMEOUT_SECONDS=180
MAI_MAX_RETRIES=4
MAI_CACHE_ENABLED=true
MAI_USE_PRIORITY_NAMES=true
MAI_DIARIZATION=false

# Long-VOD pipeline (existing MAI_* variables remain compatible)
ASR_AUDIO_BITRATE=32k
ASR_CHUNK_SECONDS=240
ASR_CHUNK_OVERLAP_SECONDS=15
ASR_MIN_CONCURRENCY=1
ASR_MAX_CONCURRENCY=2
ASR_INITIAL_CONCURRENCY=2
ASR_RETRY_COUNT=3
ASR_TIMEOUT_SECONDS=180
ASR_QUALITY_MIN_CONFIDENCE=0.5
ASR_QUALITY_RETRY_LIMIT=0
SEMANTIC_WINDOW_SECONDS=180
SEMANTIC_WINDOW_OVERLAP_SECONDS=20
MIN_SCOUT_WORDS=8
SCOUT_MAX_CONCURRENCY=4
SCOUT_MIN_SCORE=36
# Blank model names use the existing scoring provider/model; choose supported models on that provider.
SCOUT_MODEL=gpt-5.4-mini
SCOUT_REASONING=off
JUDGE_MODEL=grok-4.6
JUDGE_ENABLED=true
JUDGE_REASONING_EFFORT=low
JUDGE_MAX_CONCURRENCY=3
JUDGE_ALWAYS_TOP=0
JUDGE_ALSO_EVERYTHING_OVER=999
JUDGE_ONLY_AMBIGUOUS=true
JUDGE_MIN_SCORE=40
JUDGE_MAX_SCORE=74
JUDGE_ALSO_ON_OVERLAP=true
JUDGE_ALSO_ON_CLOSE_SCORES=true
JUDGE_CLOSE_SCORE_DELTA=5
JUDGE_MAX_CALLS_PER_JOB=8
JUDGE_MAX_PROMPT_TOKENS=20000
JUDGE_TIMEOUT_SECONDS=45
JUDGE_BATCH_MODE=false
PROFILE=FAST
DEEP_ANALYSIS_MAX_CONCURRENCY=2
VISUAL_VERIFY_MIN_SCORE=60
MAX_RENDER_CONCURRENCY=2
CUSTOMER_MAX_CLIPS_PER_JOB=8
PARALLEL_HLS_INGEST=true
HLS_CONCURRENT_FRAGMENTS=6
HLS_MAX_HEIGHT=720
MERGE_WINDOWS_PER_BATCH=8
MERGE_SCORING_MAX_CONCURRENCY=4
MERGE_GAP_SECONDS=12
MAX_MERGE_SPAN_SECONDS=120
MAX_TEMP_GB=8

# ---------- Product/SaaS launch policy ----------
# New accounts receive 3 hours of source-video credit by default.
FREE_TRIAL_CREDITS=180
# Customer generated media/transcripts/clips are scheduled for cleanup after 5 days.
RETENTION_DAYS=5
# Local/dev process guardrails. Production should replace this with a distributed queue.
SOFT_CONCURRENT_JOB_WARNING=3
HARD_LOCAL_JOB_CAP=8
# Customer long-job guardrail. 0 means unlimited; 24h is the launch-safe default.
MAX_SOURCE_HOURS=24
MAX_UPLOAD_GB=12
# Generic live source; set per job by the web app. Supports Kick/Twitch/YouTube via streamlink.
LIVE_SOURCE=
# Optional completion email. Browser notifications require no server provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Long-VOD speed profile (launch default)
FAST_VOD_MODE=true
SCOUT_WINDOWS_PER_BATCH=2
DEEP_WINDOWS_PER_BATCH=8
AUDIO_INGEST_BITRATE=32k
CONTEXT_REVIEW_LIMIT=0
PORT=5059

# Fast ASR chunk preparation. The normal VOD path already produces 16 kHz AAC,
# so copy AAC frames into each upload chunk instead of re-encoding to MP3.
ASR_FAST_CHUNK_COPY=true

# HLS resilience without unbounded retry loops.
HLS_RETRIES=5
HLS_FRAGMENT_RETRIES=8
HLS_SOCKET_TIMEOUT_SECONDS=20
HLS_BUFFER_SIZE=4M

# IRL-aware moment detection / cutting
IRL_MAX_MERGE_SPAN_SECONDS=65
IRL_MERGE_GAP_SECONDS=7
IRL_PEAK_NEIGHBOR_FLOOR=55
IRL_VERY_HIGH_PEAK_MAX_GAP_SECONDS=8
IRL_DILUTION_SPLIT_THRESHOLD=12

# 2026-09-22 fast long-VOD profile (Together account is capped at 8 concurrent calls)
# Keep provider concurrency at 8. Smaller 4-minute chunks reduce retry cost and time-to-first-text.
AUDIO_INGEST_BITRATE=32k
HLS_CONCURRENT_FRAGMENTS_FALLBACK=6
HLS_CONCURRENT_FRAGMENTS_MAX=6

# Fastest long-VOD path: transcribe remote HLS ranges while the rest remains remote
ROLLING_REMOTE_ASR=true

# Rolling ASR automatically resolves an audio-only HLS rendition when available.
ROLLING_AUDIO_ONLY_RESOLUTION=true

# Threaded dashboard/API server; media processing stays in subprocesses.
HTTP_THREADS=8

# Canonical analysis models (one provider per role)
OPENAI_SCORING_MODEL=gpt-5.4-mini
DEEP_SCORING_MODEL=gpt-5.4-mini
GROK_SCORING_MODEL=grok-4.6
GROK_TITLE_MODEL=grok-4.6

